{
  "name": "Block",
  "type": "object",
  "properties": {
    "wellenId": {
      "type": "string",
      "title": "Wellen ID"
    },
    "titel": {
      "type": "string",
      "title": "Titel"
    },
    "reihenfolge": {
      "type": "number",
      "default": 0,
      "title": "Reihenfolge"
    },
    "motivationstext": {
      "type": "string",
      "title": "Motivationstext",
      "format": "textarea"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "title": "Beschreibung",
      "description": "Kurze Beschreibung des Datensatzes f\u00fcr Suche und Vorschau, bis 1000 Zeichen."
    }
  },
  "required": [
    "wellenId",
    "titel"
  ]
}