{
  "name": "Bibliotheksfrage",
  "properties": {
    "auswertungstag": {
      "title": "Auswertungs-Tag",
      "type": "string"
    },
    "bezugSchluessel": {
      "description": "Schl\u00fcssel der Hauptfrage, auf die sich diese Folgefrage bezieht (z. B. Warum-Frage zu einer Metaphernfrage)",
      "title": "Bezug auf Frage",
      "type": "string"
    },
    "container": {
      "default": "Allgemein",
      "title": "Container",
      "type": "string"
    },
    "erklaerung": {
      "format": "textarea",
      "title": "Erkl\u00e4rung",
      "type": "string"
    },
    "hilfetext": {
      "title": "Hilfetext",
      "type": "string"
    },
    "kategorie": {
      "title": "Kategorie",
      "type": "string"
    },
    "kernfrage": {
      "default": false,
      "description": "Teil des gesperrten Benchmark-Kerns \u2014 Text und Optionen d\u00fcrfen nicht ver\u00e4ndert werden.",
      "title": "Kernfrage",
      "type": "boolean"
    },
    "kernversion": {
      "description": "Version des Fragenkerns, z. B. 1.0",
      "title": "Kernversion",
      "type": "string"
    },
    "matrixZeilen": {
      "items": {
        "type": "string"
      },
      "title": "Matrix-Zeilen",
      "type": "array"
    },
    "matrixZeilenIds": {
      "description": "Stabile ID je Matrix-Zeile, parallel zu matrixZeilen. Fehlt sie, gilt der Zeilenindex als ID.",
      "items": {
        "type": "string"
      },
      "title": "Matrix-Zeilen-IDs",
      "type": "array"
    },
    "maxAuswahl": {
      "description": "H\u00f6chstanzahl bei Mehrfachauswahl und Limbic",
      "title": "Max. Auswahl",
      "type": "number"
    },
    "minAuswahl": {
      "description": "Mindestanzahl bei Mehrfachauswahl und Limbic",
      "title": "Min. Auswahl",
      "type": "number"
    },
    "optionen": {
      "items": {
        "type": "string"
      },
      "title": "Optionen",
      "type": "array"
    },
    "pflicht": {
      "default": true,
      "title": "Pflichtfrage",
      "type": "boolean"
    },
    "polaritaet": {
      "default": "neutral",
      "description": "pro = steht f\u00fcr, contra = steht nicht f\u00fcr",
      "enum": [
        "neutral",
        "pro",
        "contra"
      ],
      "title": "Polarit\u00e4t",
      "type": "string"
    },
    "reihenfolge": {
      "default": 0,
      "title": "Reihenfolge",
      "type": "number"
    },
    "schluessel": {
      "description": "Stabiler, kunden\u00fcbergreifender Schl\u00fcssel (z. B. andi_i_wertewelt_pro). Grundlage f\u00fcr Benchmark und Auswertung.",
      "title": "Fragenschl\u00fcssel",
      "type": "string"
    },
    "skalaLabelLinks": {
      "title": "Skala-Label links",
      "type": "string"
    },
    "skalaLabelRechts": {
      "title": "Skala-Label rechts",
      "type": "string"
    },
    "skalaMax": {
      "default": 5,
      "title": "Skala Max",
      "type": "number"
    },
    "skalaMin": {
      "default": 1,
      "title": "Skala Min",
      "type": "number"
    },
    "sprachantwortErlaubt": {
      "default": false,
      "title": "Sprachantwort erlaubt",
      "type": "boolean"
    },
    "stufenWorte": {
      "items": {
        "properties": {
          "bis": {
            "title": "Bis Wert",
            "type": "number"
          },
          "wort": {
            "title": "Wort",
            "type": "string"
          }
        },
        "required": [
          "bis",
          "wort"
        ],
        "type": "object"
      },
      "title": "Stufen-Worte",
      "type": "array"
    },
    "text": {
      "format": "textarea",
      "title": "Fragetext",
      "type": "string"
    },
    "typ": {
      "enum": [
        "single_choice",
        "multi_choice",
        "skala",
        "werte_auswahl",
        "limbic",
        "freitext",
        "ja_nein",
        "schieberegler",
        "gegensatzpaar",
        "matrix"
      ],
      "title": "Fragetyp",
      "type": "string"
    },
    "zielgruppe": {
      "default": "allgemein",
      "enum": [
        "geschaeftsfuehrung",
        "mitarbeiter",
        "kunden",
        "partner",
        "allgemein"
      ],
      "title": "Zielgruppe",
      "type": "string"
    }
  },
  "required": [
    "typ",
    "text"
  ],
  "type": "object"
}