{
  "name": "Bibliotheksfrage",
  "type": "object",
  "properties": {
    "reihenfolge": {
      "type": "number",
      "default": 0,
      "title": "Reihenfolge"
    },
    "typ": {
      "type": "string",
      "enum": [
        "single_choice",
        "multi_choice",
        "skala",
        "werte_auswahl",
        "limbic",
        "freitext",
        "ja_nein",
        "schieberegler",
        "gegensatzpaar",
        "matrix"
      ],
      "title": "Fragetyp"
    },
    "text": {
      "type": "string",
      "title": "Fragetext",
      "format": "textarea"
    },
    "hilfetext": {
      "type": "string",
      "title": "Hilfetext"
    },
    "erklaerung": {
      "type": "string",
      "title": "Erkl\u00e4rung",
      "format": "textarea"
    },
    "pflicht": {
      "type": "boolean",
      "default": true,
      "title": "Pflichtfrage"
    },
    "optionen": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Optionen"
    },
    "skalaMin": {
      "type": "number",
      "default": 1,
      "title": "Skala Min"
    },
    "skalaMax": {
      "type": "number",
      "default": 5,
      "title": "Skala Max"
    },
    "skalaLabelLinks": {
      "type": "string",
      "title": "Skala-Label links"
    },
    "skalaLabelRechts": {
      "type": "string",
      "title": "Skala-Label rechts"
    },
    "stufenWorte": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "bis": {
            "type": "number",
            "title": "Bis Wert"
          },
          "wort": {
            "type": "string",
            "title": "Wort"
          }
        },
        "required": [
          "bis",
          "wort"
        ]
      },
      "title": "Stufen-Worte"
    },
    "matrixZeilen": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Matrix-Zeilen"
    },
    "auswertungstag": {
      "type": "string",
      "title": "Auswertungs-Tag"
    },
    "sprachantwortErlaubt": {
      "type": "boolean",
      "default": false,
      "title": "Sprachantwort erlaubt"
    },
    "zielgruppe": {
      "type": "string",
      "enum": [
        "geschaeftsfuehrung",
        "mitarbeiter",
        "kunden",
        "partner",
        "allgemein"
      ],
      "default": "allgemein",
      "title": "Zielgruppe"
    },
    "kategorie": {
      "type": "string",
      "title": "Kategorie"
    },
    "container": {
      "type": "string",
      "title": "Container",
      "default": "Allgemein"
    }
  },
  "required": [
    "typ",
    "text"
  ]
}