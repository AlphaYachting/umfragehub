{
  "name": "Welle",
  "properties": {
    "abschlusstext": {
      "format": "textarea",
      "title": "Abschlusstext",
      "type": "string"
    },
    "begruessungstext": {
      "format": "textarea",
      "title": "Begr\u00fc\u00dfungstext",
      "type": "string"
    },
    "eingeladen": {
      "description": "Wie viele Personen den Link bekommen haben \u2014 Grundlage f\u00fcr die R\u00fccklaufquote. Optional.",
      "title": "Eingeladene Personen",
      "type": "number"
    },
    "einladungsModus": {
      "default": "gemeinsam",
      "description": "gemeinsam = ein Link f\u00fcr alle, Erinnerung geht an alle. persoenlich = eigener Link je Adresse, Erinnerung nur an Personen, die noch nicht begonnen haben.",
      "enum": [
        "gemeinsam",
        "persoenlich"
      ],
      "title": "Einladungsmodus",
      "type": "string"
    },
    "endetAm": {
      "description": "Geplantes Ende der Welle (Frist f\u00fcr die Befragten). Optional, schlie\u00dft die Welle nicht automatisch.",
      "format": "date",
      "title": "L\u00e4uft bis",
      "type": "string"
    },
    "geschaetzteDauerMinuten": {
      "default": 10,
      "title": "Gesch\u00e4tzte Dauer (Minuten)",
      "type": "number"
    },
    "linkToken": {
      "title": "Link Token",
      "type": "string"
    },
    "mailBetreff": {
      "title": "Einladung: Betreff",
      "type": "string"
    },
    "mailText": {
      "format": "textarea",
      "title": "Einladung: Text",
      "type": "string"
    },
    "mindestTeilnehmer": {
      "default": 6,
      "title": "Mindestteilnehmer",
      "type": "number"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "projektId": {
      "title": "Projekt ID",
      "type": "string"
    },
    "reminderBetreff": {
      "title": "Erinnerung: Betreff",
      "type": "string"
    },
    "reminderText": {
      "format": "textarea",
      "title": "Erinnerung: Text",
      "type": "string"
    },
    "status": {
      "default": "entwurf",
      "enum": [
        "entwurf",
        "live",
        "geschlossen"
      ],
      "title": "Status",
      "type": "string"
    },
    "zielgruppe": {
      "default": "mitarbeiter",
      "enum": [
        "geschaeftsfuehrung",
        "mitarbeiter",
        "kunden",
        "partner"
      ],
      "title": "Zielgruppe",
      "type": "string"
    }
  },
  "required": [
    "projektId",
    "name"
  ],
  "type": "object"
}