{
  "description": "Anfrage f\u00fcr ein Erstgespr\u00e4ch \u00fcber das Formular auf andifragt.at/kontakt. Wird nur \u00fcber die Funktion anfrage angelegt, lesen d\u00fcrfen nur Admins.",
  "name": "Anfrage",
  "properties": {
    "name": {
      "title": "Name",
      "type": "string",
      "maxLength": 120
    },
    "firma": {
      "title": "Unternehmen",
      "type": "string",
      "maxLength": 160
    },
    "email": {
      "title": "E-Mail",
      "type": "string",
      "maxLength": 200
    },
    "telefon": {
      "title": "Telefon",
      "type": "string",
      "maxLength": 60
    },
    "themen": {
      "title": "Themen",
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "positionierung",
          "team",
          "kunden",
          "vertrieb",
          "einstieg",
          "offen"
        ]
      }
    },
    "kanal": {
      "title": "Gespr\u00e4chsart",
      "type": "string",
      "enum": [
        "telefon",
        "online"
      ]
    },
    "nachricht": {
      "title": "Was besch\u00e4ftigt dich gerade?",
      "type": "string",
      "maxLength": 3000
    },
    "herkunft": {
      "title": "Seite, von der die Anfrage kam",
      "type": "string",
      "maxLength": 200
    },
    "status": {
      "title": "Status",
      "type": "string",
      "enum": [
        "neu",
        "beantwortet",
        "erledigt"
      ],
      "default": "neu"
    },
    "mailOk": {
      "title": "Benachrichtigung verschickt",
      "type": "boolean",
      "default": false
    },
    "mailFehler": {
      "title": "Fehler beim Versand",
      "type": "string",
      "maxLength": 300
    }
  },
  "required": [
    "name",
    "email"
  ],
  "type": "object",
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}